{
  "expo": {
    "name": "StyleSense",
    "slug": "stylesense",
    "scheme": "stylesense",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1F2B5C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stylesense.app"
    },
    "android": {
      "package": "com.stylesense.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F2B5C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2B5C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "StyleSense uses your photos to find similar clothes and for virtual try-on. Photos are deleted within 24 hours.",
          "cameraPermission": "StyleSense uses the camera to find clothes like the ones you photograph and for virtual try-on. Photos are deleted within 24 hours."
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
