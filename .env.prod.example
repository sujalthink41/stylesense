# Homelab production settings. On the server: cp .env.prod.example .env, fill in every
# CHANGE-ME, then run ./scripts/deploy.sh. Never commit .env.

# --- App ---
APP_ENV=production
APP_LOG_LEVEL=INFO
TZ=Asia/Kolkata

# --- Your public address (Cloudflare Tunnel hostname). Share and poll links use it too. ---
APP_PUBLIC_WEB_URL=https://CHANGE-ME.yourdomain.com
APP_SUPPORT_EMAIL=CHANGE-ME@gmail.com

# --- Cloudflare Tunnel: Zero Trust → Networks → Tunnels → your tunnel → the token ---
CLOUDFLARE_TUNNEL_TOKEN=CHANGE-ME

# --- Postgres ---
POSTGRES_USER=stylesense
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=stylesense
BACKUP_KEEP_DAYS=7

# --- Auth ---
# Generate: openssl rand -base64 48  (a NEW one, not the dev secret)
APP_JWT_SECRET=CHANGE-ME
# The Web client ID (same as in mobile/eas.json), as a JSON list
APP_GOOGLE_CLIENT_IDS=["CHANGE-ME.apps.googleusercontent.com"]
APP_ADMIN_EMAILS=[]
# Must stay false: the server refuses to start in production with it on
APP_DEV_SIGN_IN_ENABLED=false

# --- AI ---
APP_OPENAI_API_KEY=CHANGE-ME
APP_GROQ_API_KEY=CHANGE-ME
APP_STYLIST_AI_REASONS=false
APP_LLM_DAILY_BUDGET_USD=2.00
APP_EMBEDDING_MODEL=hashing

# --- Media (Cloudinary) ---
APP_CLOUDINARY_CLOUD_NAME=CHANGE-ME
APP_CLOUDINARY_API_KEY=CHANGE-ME
APP_CLOUDINARY_API_SECRET=CHANGE-ME
APP_CLOUDINARY_UPLOAD_PRESET=stylesense_user_uploads

# --- Products: live search of Amazon.in, Flipkart and Myntra (free) ---
APP_WEB_SEARCH_ENABLED=true

# --- Try-on (OpenAI image editing, about ₹5-6 each) ---
APP_TRYON_PROVIDER=openai
APP_TRYON_OPENAI_MODEL=gpt-image-2
APP_TRYON_OPENAI_QUALITY=medium
APP_TRYON_OPENAI_INPUT_FIDELITY=
APP_TRYON_PRICE_IMAGE_INPUT=8
APP_TRYON_PRICE_TEXT_INPUT=5
APP_TRYON_PRICE_OUTPUT=30
# Per person per day, and for everyone together (30 ≈ ₹180/day at most while friends test)
APP_TRYON_DAILY_LIMIT=3
APP_TRYON_GLOBAL_DAILY_LIMIT=30
