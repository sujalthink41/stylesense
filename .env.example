# Copy to .env and fill in. Never commit .env.

# --- App (backend reads APP_*) ---
APP_ENV=local
APP_LOG_LEVEL=INFO
APP_VERSION=dev

# --- Postgres (used by compose) ---
POSTGRES_USER=stylesense
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=stylesense

# --- Host ports for the dev stack (5434 avoids clashing with a native Postgres) ---
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# --- For running the API on the host (outside Docker) ---
APP_DATABASE_URL=postgresql+asyncpg://stylesense:change-me-locally@localhost:5434/stylesense
APP_REDIS_URL=redis://localhost:6379/0

# --- Observability stack (make obs-up) ---
GRAFANA_ADMIN_PASSWORD=change-me-locally
GLITCHTIP_DB_PASSWORD=change-me-locally
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
# Create a project in GlitchTip (http://localhost:8001), then paste its DSN here.
APP_SENTRY_DSN=
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090
GLITCHTIP_HOST_PORT=8001
UPTIME_HOST_PORT=3002

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JSON lists. Client IDs come from Google Cloud Console (see docs/guides/google-sign-in-setup.md).
APP_GOOGLE_CLIENT_IDS=[]
APP_ADMIN_EMAILS=[]
# Local only: lets the mobile app (Expo Go) sign in by email without Google. Refused in production.
APP_DEV_SIGN_IN_ENABLED=false

# --- AI gateway ---
# A provider is enabled only when its key is set. Never paste keys anywhere but this file.
APP_OPENAI_API_KEY=
APP_ANTHROPIC_API_KEY=
APP_LLM_DAILY_BUDGET_USD=2.00
# "hashing" (offline) or "provider:model", e.g. openai:text-embedding-3-small (1536 dims)
APP_EMBEDDING_MODEL=hashing

# --- Public site ---
# Where share (/l/...) and poll (/p/...) links point; also the Android App Links host.
APP_PUBLIC_WEB_URL=http://localhost:3000

# --- Media (Cloudinary) ---
# Photo search and try-on need all three. Setup: docs/guides/cloudinary-setup.md
APP_CLOUDINARY_CLOUD_NAME=
APP_CLOUDINARY_API_KEY=
APP_CLOUDINARY_API_SECRET=
APP_CLOUDINARY_UPLOAD_PRESET=stylesense_user_uploads

# --- Virtual try-on ---
# none = off; fake = returns the garment image (local testing only, refused in production)
APP_TRYON_PROVIDER=none
APP_TRYON_DAILY_LIMIT=3
APP_TRYON_GLOBAL_DAILY_LIMIT=200
